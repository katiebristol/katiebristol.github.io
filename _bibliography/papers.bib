@inproceedings{Sprain_et_al-2025-Deccan_QPSV,
  title     = {Using Quantitative Paleosecular Variation Analysis to Refine the Tempo of Deccan Eruptions},
  author    = {Sprain, CJ and Bristol, KE and Mittal, T and Fendley, IM and Tremblay, MM and Mijjum, M and Monteiro, A and Duraiswami, R},
  abstract  = {Large igneous provinces (LIPs) occur throughout Earth’s history and are commonly temporally linked with major environmental crises, most notably mass extinctions. Quantifying the tempo of LIP eruptions is critical for understanding the impact these volcanic systems have on the global environment. This is especially critical for LIPs where the influence of volcanism is still being debated, like the Deccan Traps and their association with the Cretaceous-Paleogene mass extinction. Recent work to constrain rates of Deccan eruption utilized high-precision geochronology to obtain absolute ages for flows and zircon-bearing red boles between flows. Although this work makes Deccan one of the most precisely dated LIPs, uncertainties on ages from high-precision geochronology techniques are still on the order of 10s of ka, with many dates overlapping within uncertainty over hundreds of meters of volcanic stratigraphy. Although higher resolution can be achieved using Bayesian age models, this resolution generally still cannot assess the duration of time between individual flows. Outside of absolute geochronologic methods, we have developed a new technique called Quantitative Paleosecular Variation to generate quantitative predictions about eruption tempo by combining geochronologic and paleomagnetic data, along with qualitative constraints from lava flow morphology and geochemistry. This technique utilizes a generalized forward modeling approach to compare real magnetic data with pseudo-paleomagnetic datasets, created using synthetic eruptive histories from down-sampled secular variation records, in a Bayesian inversion framework. This approach assesses the most likely eruption history including duration of eruptive pulses, active eruptive time, and hiatus duration between pulses, hence providing a quantitative estimate of eruption tempo at timescales less than 10,000 years. In this work, we have applied this method to new paleomagnetic data collected from the Matheran section in the Deccan Traps. Our results indicate that during this interval, eruptions occurred roughly every 3,000 yrs, with no significant hiatuses between eruptive pulses. As a result, the Deccan Traps likely caused a series of short-lived cooling intervals via sulfur emissions. However, the several thousand years between eruptions preclude the possibility of prolonged cooling due to the comparatively short decay timescale of sulfate aerosols in the atmosphere.},
  booktitle = {Geological Society of America Abstracts},
  volume    = {57},
  number    = {6},
  year      = {2025},
  html      = {https://gsameetings.secure-platform.com/connects25/gallery/rounds/82002/details/16067},
  doi       = {10.1130/abs/2025AM-10066},
  preview   = {Sprain_et_al-2025-Deccan_QPSV.png}
}

@inproceedings{Bristol-2024-Fast_Furious,
  title       = {Fast and Furious: Magnetic Drift - Using Quantitative Paleosecular Variation Techniques to Quantify the Tempo of Large Igneous Provinces},
  author      = {Bristol, KE},
  abstract    = {Large Igneous Provinces (LIPs) are areas where exceptionally large volumes of volcanic rocks have been emplaced over a relatively short geologic timeframe. The study of LIPs is crucial due to their association with fundamental Earth processes such as mantle plumes and continental rifting. Moreover, LIPs tend to coincide with dramatic events in Earth history including mass extinctions, rapid climate shifts, and major environmental perturbations. Therefore, constraining their chronological framework is essential to research questions in fields such as volcanology, tectonics, paleoclimate, and more. Existing geochronological methods can determine time between individual lava flows if the ages of the flows do not fall within the margin of error from one another (10’s of ka). For example, in the Deccan Traps LIP many dates overlap across hundreds of meters of volcanic stratigraphy, necessitating an additional chronometer. Analysis of paleomagnetic directions between flows in conjunction with detailed knowledge of the stratigraphy can be used to construct a relative eruption history. To predict eruption rates quantitatively, we developed a novel technique that uses existing geochronological data in combination with paleomagnetic data, geochemistry, and lava flow morphology. This forward modelling approach compares magnetic data in a Bayesian inversion framework with synthetic eruption histories produced by downsampling real secular variation records. The result is a set of predictions which can assess the eruption tempo based on the most probable number of eruption pulses, eruption duration, and hiatus durations between pulses. In addition to directional data, we also present preliminary paleointensity estimates for these samples. Future work will refine these predictions by incorporating cosmogenic data to estimate surface exposure durations between flows. This approach is particularly advantageous as it incorporates information from multiple subdisciplines and improves overall resolution of estimates for multiple facets of LIP emplacement tempo. Overall, this method represents a valuable tool for determining the eruptive histories of LIPs.},
  booktitle   = {Magnetic NetworkZ (MagNetZ) Seminars},
  volume      = {2024},
  doi         = {10.7288/V4/ERDA/2733},
  year        = {2024},
  video       = {https://www.youtube.com/watch?v=28MFB4GqVRU},
  preview     = {placeholder.svg}
}

@inproceedings{Bristol_et_al-2023-Deccan_QPSV,
  title       = {Assessing Eruptive Hiatus Durations of the Deccan Traps Large Igneous Province Using Quantitative Paleosecular Variation Analysis},
  author      = {Bristol, KE and Sprain, CJ and Griffis, A and Mittal, T and Fendley, IM and Duraiswami, RA and Monteiro, A and Mijjum, M and Tremblay, MM},
  abstract    = {Large Igneous Provinces (LIPs) are areas where exceptionally large volumes of volcanic rocks have been emplaced over a relatively short geologic timeframe. The study of LIPs is important as they are linked to significant Earth processes such as mantle plumes and continental rifting. In addition, LIPs tend to coincide with mass extinction events, periods of rapid climatic change, and major environmental perturbations. Therefore, constraining their chronology is essential to research questions in fields such as volcanology, tectonics, paleoclimate, and more. Existing geochronological methods can determine time between individual lava flows if the ages of the flows do not fall within the margin of error from one another (10's of ka). In the Deccan Traps LIP, many dates overlap across hundreds of meters of volcanic stratigraphy, necessitating an additional chronometer. Analysis of paleomagnetic directions between flows, in combination with detailed knowledge of the stratigraphy, can be used to construct a relative eruption history. To build upon this, we developed a new technique that uses existing geochronological data in combination with paleomagnetic data, geochemistry, and lava flow morphology to predict eruption rates quantitatively. This forward modelling approach compares magnetic data in a Bayesian inversion framework with synthetic eruption histories produced by downsampling secular variation records. The result is a set of predictions which can assess the eruption tempo based on the most probable number of eruption pulses, eruption duration, and time spans between pulses. Future work will enhance these predictions by adding cosmogenic information to estimate surface exposure durations between flows. This approach is particularly advantageous as it incorporates information from multiple subdisciplines and improves overall resolution of estimates for multiple facets of LIP emplacement tempo. Overall, this method represents a valuable tool for determining the eruptive histories of LIPs.},
  booktitle   = {AGU Fall Meeting Abstracts},
  volume      = {2023},
  pages       = {GP33A--01},
  year        = {2023},
  html        = {https://ui.adsabs.harvard.edu/abs/2023AGUFMGP33A..01B/abstract},
  award       = {OSPAs are awarded to promote, recognize, and reward undergraduate, Master’s, and PhD students for quality research in Earth and space science and the ability to effectively communicate it.*},
  award_name  = {Outstanding Student Presentation Award},
  preview     = {Bristol_et_al-2023-Deccan_QPSV.png}
}

@inproceedings{Bristol_et_al-2022-India_PINT,
  title     = {New Absolute Paleointensity Estimates from Mafic Dikes of India and the Variability of the Precambrian Geomagnetic Field},
  author    = {Bristol, KE and Sprain, CJ and Piispa, EJ and Smirnov, AV and Meert, JG and Dann, A},
  abstract  = {The global paleointensity record has been an important tool for the investigation of the evolution of Earth's core. A notable signature in the paleointensity record that has sparked debate in recent years is the apparent spike in paleointensity between 1.0 - 1.5 Ga. Some have postulated that this increase represents the nucleation of the inner core while others refute this claim, reporting ultra-low paleointensity values and a decreasing trend in field strength through the end of the Ediacaran as evidence for a younger inner core. To test between these hypotheses, we performed additional paleointensity experiments on an array of Proterozoic-aged samples from four different localities in India - The Malani Igneous Suite (~750 - 752 Ma), Bastar Craton (~1.88 Ga), Bundelkhand Craton (~1.98 Ga), and Dharwar Craton (~2.37 Ga). To increase experiment success, multiple paleointensity methods were used including the IZZI protocol, multispecimen, and quasi-perpendicular. Preliminary results suggest high field variability through the Proterozoic and emphasize the need for additional high-quality paleointensity estimates from Precambrian. Additionally, the results highlight the importance of method choice when dealing with samples of this age.},
  booktitle = {AGU Fall Meeting Abstracts},
  volume    = {2022},
  pages     = {GP26A--02},
  year      = {2022},
  html      = {https://ui.adsabs.harvard.edu/abs/2022AGUFMGP26A..02B/abstract},
  preview   = {Bristol_et_al-2022-India_PINT.png}
}

@inproceedings{Mijjum_et_al-2021-Production_Rates,
  title     = {A Model Framework for Cosmogenic Nuclide Production Rates Through Deep Time},
  author    = {Mijjum, M and Bristol, KE and Tremblay, MM and Sprain, CJ},
  abstract  = {Multiple scaling schemes for cosmogenic nuclide production rates have been developed for the late Quaternary, the period over which most cosmogenic nuclide measurements are applicable. Applications of cosmogenic nuclide measurements on longer timescales to address questions regarding landscape evolution and surface exposure durations are becoming more prevalent. However, production rate calculations through deep time (i.e., pre-late Quaternary) have primarily utilized Quaternary or present-day scaling factors. To increase the accuracy of scaling schemes through deep time, spatiotemporal variations in physical parameters (e.g. geomagnetic field intensity and paleogeography) beyond the Quaternary should be accounted for. We present a production rate scaling scheme model for the past 70 My. This model builds on existing scaling schemes while incorporating effects relevant to deep time applications, specifically by, (1) accounting for site-specific changes in paleolatitude, and (2) integrating geomagnetic field intensity data from two global paleomagnetic databases. We evaluate the efficacy of our model by applying it to existing datasets from paleo exposure sites, and from sites with apparent continuous million-year exposure histories. Our model will enable measurements of stable cosmogenic nuclides to be applied to research questions such as constraining paleoexposure durations between lava flows, quantifying sediment storage on ~Ma timescales, and calculating the formation timescales of paleosurfaces.},
  booktitle = {Geological Society of America Abstracts},
  volume    = {53},
  number    = {6},
  pages     = {364512},
  year      = {2021},
  html      = {https://gsa.confex.com/gsa/2021AM/webprogram/Paper364512.html},
  doi       = {10.1130/abs/2021AM-364512},
  preview   = {Mijjum_et_al-2021-Production_Rates.png}
}

